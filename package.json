{
  "name": "website-qa-health-scanner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website QA Health Scanner — crawl, analyze, and report website quality",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run worker\"",
    "dev:web": "npm run dev -w @qa-scanner/web",
    "dev:api": "npm run dev -w @qa-scanner/api",
    "worker": "npm run worker -w @qa-scanner/api",
    "build": "npm run build -w @qa-scanner/web && npm run build -w @qa-scanner/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @qa-scanner/web",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @qa-scanner/web && npm run typecheck -w @qa-scanner/api",
    "postinstall": "prisma generate",
    "playwright:install": "playwright install chromium firefox webkit",
    "fixtures": "tsx tests/fixtures/server.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1"
  },
  "engines": {
    "node": ">=20"
  }
}
