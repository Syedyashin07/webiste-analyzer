# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qa_scanner?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# OpenAI (optional — scans still complete without AI analysis)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# API
PORT=3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Scan defaults
SCAN_MAX_PAGES=100
SCAN_MAX_DEPTH=5
SCAN_TIMEOUT_MS=30000
SCAN_CONCURRENCY=3
SCAN_CRAWL_DELAY_MS=250
SCAN_MAX_DURATION_MS=1800000
SCREENSHOT_ENABLED=true
VIDEO_ENABLED=true

# Local/test targets (keep false for real scans; tests set this to true)
ALLOW_LOCAL_TARGETS=false

# Storage (optional override; defaults to ./storage)
STORAGE_DIR=
